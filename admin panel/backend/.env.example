# Platform tier — authoritative for financial safety (development | staging | production)
PLATFORM_TIER=development
NODE_ENV=development

# JWT — required; no code defaults (≥32 characters, not in weak-secret list)
JWT_SECRET=your-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_INVITE_SECRET=another-long-random-secret-at-least-32-chars
ADMIN_SESSION_TTL_MS=604800000

# One-time bootstrap super_admin (first deploy only; remove after invite flow used)
# BOOTSTRAP_ADMIN_EMAIL=super@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=use-min-12-chars-complex-password
# BOOTSTRAP_ADMIN_NAME=Platform Super Admin

# Supabase — required for all tiers; no in-memory financial fallback
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Agora Voice Calling — https://docs.agora.io/en/voice-calling/overview/product-overview
# Production/staging: AGORA_APP_ID (32-char hex) + AGORA_APP_CERTIFICATE (≥32 chars)
# Development only: AGORA_TOKEN OR certificate (mutually exclusive)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
# AGORA_TOKEN=

# Razorpay — staging: rzp_test_* ; production: rzp_live_*
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase Admin SDK (preferred over service-account.json)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_ALLOW_FILE_CREDENTIALS=true

# Payout account field encryption (≥32 chars; required for PUT /api/creator/withdrawals/account)
PAYOUT_FIELD_ENCRYPTION_KEY=your-payout-encryption-key-at-least-32-characters-long

# Server
PORT=5000
CORS_ORIGINS=http://localhost:3000
ENABLE_SWAGGER=false
ALLOW_MOCK_PAYMENTS=false
MOCK_PAYMENTS_ENABLED=false
# Admin self-registration removed — use POST /api/admin/invites (super_admin) + accept flow
